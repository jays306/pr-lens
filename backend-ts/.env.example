# PR-LENS TypeScript Backend Configuration

# GitHub personal access token (repo read access)
# Optional if clients send Authorization: Bearer <token> from the Chrome extension
# GITHUB_TOKEN=ghp_your_token_here

# Anthropic API key (required for claude provider)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Claude model to use (optional — defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Shallow-clone repos for full codebase context (default: true)
# Set to false to disable cloning and fall back to diff-only analysis
# CLONE_REPOS=true

# Server port
PORT=8080

# Allowed origins for CORS (comma-separated, or * for any)
CORS_ORIGINS=*
