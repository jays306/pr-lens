# PR-LENS Backend Configuration

# GitHub personal access token (repo read access). Optional if clients send Authorization: Bearer (e.g. PR-LENS Chrome extension).
# GITHUB_TOKEN=ghp_your_token_here

# Review harness: "claude" (Claude Code) or "codex".
# If unset, AI_PROVIDER=openai selects Codex and everything else selects Claude Code.
# AGENT_HARNESS=claude
# CLAUDE_BIN=claude
# CODEX_BIN=codex

# AI provider: "claude" (default) | "bedrock" | "openai"
AI_PROVIDER=claude

# Anthropic API key (used when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Anthropic base URL (optional — override for proxies or local Claude)
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Claude model to use (optional)
# claude default: claude-sonnet-4-6  |  bedrock default: us.anthropic.claude-sonnet-4-6
# See: https://docs.anthropic.com/en/docs/about-claude/models
# ANTHROPIC_MODEL=claude-opus-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Claude Code on Bedrock: AI_PROVIDER=bedrock sets CLAUDE_CODE_USE_BEDROCK and
# --model from ANTHROPIC_MODEL (anthropic.* IDs get a us. prefix).
# For a LiteLLM proxy instead, set ANTHROPIC_MODEL=bedrock/us.anthropic.claude-opus-5

# ── Amazon Bedrock (AI_PROVIDER=bedrock) ────────────────────────────────────
# Option A — API key (bearer token). Generate one in the AWS Bedrock console.
# BEDROCK_API_KEY=your-bedrock-api-key
#
# Option B — Standard AWS credentials (leave BEDROCK_API_KEY unset).
# Uses the credential chain: env vars → ~/.aws/credentials → IAM role.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# BEDROCK_REGION=us-east-1  (defaults to us-east-1 if unset)

# OpenAI API key (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your_key_here

# Reviews always shallow-clone the PR head so Claude Code / Codex can install
# and read dependencies. Requires git on PATH.

# Server port
PORT=8080

# Allowed origins for CORS (comma-separated). Default is https://github.com.
# Use * only for local experiments — never in a shared deploy.
# CORS_ORIGINS=https://github.com

# When true, /analyze ignores the server GITHUB_TOKEN and requires a client PAT.
# /review always requires a client PAT.
# REQUIRE_CLIENT_GITHUB_TOKEN=true
