# JUST-PR Backend Configuration

# GitHub personal access token (needs repo read access)
GITHUB_TOKEN=ghp_your_token_here

# AI provider: "claude" (default) | "openai"
AI_PROVIDER=claude

# Anthropic API key (used when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Anthropic base URL (optional — override for proxies or local Claude)
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Claude model to use (optional — defaults to claude-sonnet-4-6)
# See: https://docs.anthropic.com/en/docs/about-claude/models
# ANTHROPIC_MODEL=claude-opus-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI API key (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your_key_here

# Server port
PORT=8080

# Allowed origins for CORS (comma-separated, or * for any)
CORS_ORIGINS=*
